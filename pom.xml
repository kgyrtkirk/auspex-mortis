<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>hu.rxd.auspex</groupId>
  <artifactId>hu.rxd.auspex.mortis.parent</artifactId>
  <version>0.5.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Auspex Mortis — heap dump tools for the Eclipse MCP server</name>

  <properties>
    <tycho.version>5.0.3</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>plugins</module>
    <module>tests</module>
    <module>features</module>
    <module>update-site</module>
    <module>product/hu.rxd.auspex.mortis.product</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <!-- no executions: it is invoked by hand to move the version between releases, and
           declaring it here is what pins the version that invocation gets -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-versions-plugin</artifactId>
        <version>${tycho.version}</version>
      </plugin>
      <!-- the qualifier comes from the commit that last touched the module, not from the
           clock: the same source builds the same version, whoever builds it and whenever, so
           a jar found on a machine can be traced back to what produced it -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-packaging-plugin</artifactId>
        <version>${tycho.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-buildtimestamp-jgit</artifactId>
            <version>${tycho.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <timestampProvider>jgit</timestampProvider>
          <!-- a working copy nobody committed still has to build; it says so in the log
               rather than refusing, and that build's qualifier is the clock -->
          <jgit.dirtyWorkingTree>warning</jgit.dirtyWorkingTree>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- the tests exercise pure logic against MAT's interfaces, so they need an
               OSGi runtime but no workbench and no display: that keeps them runnable on a
               headless build machine without an X server -->
          <useUIHarness>false</useUIHarness>
          <!-- a green build that ran no tests is the failure this catches: Tycho falls
               back to a provider that discovers nothing rather than saying so -->
          <failIfNoTests>true</failIfNoTests>
          <providerHint>junit5</providerHint>
          <argLine>-Xmx512m</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <file>${maven.multiModuleProjectDirectory}/target-platform/hu.rxd.auspex.mortis.target/hu.rxd.auspex.mortis.target.target</file>
          </target>
          <executionEnvironment>JavaSE-25</executionEnvironment>
          <environments>
            <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
          </environments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
